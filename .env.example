# Modo de almacenamiento de Keystatic. Con el prefijo PUBLIC_ porque el panel
# /keystatic corre en el navegador y necesita leer este valor también.
# - vacío o "local"  -> edita los ficheros del disco directamente (uso en local)
# - "github"         -> el panel /keystatic autentica con GitHub y hace commits al repo
PUBLIC_KEYSTATIC_STORAGE_KIND=local

# Solo necesarias cuando KEYSTATIC_STORAGE_KIND=github.
# Se generan creando una "GitHub App" en https://github.com/settings/apps
# (ver README para el paso a paso).
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_GITHUB_APP_SLUG=
# Cadena aleatoria larga, usada para firmar la sesión del panel. Genérala con:
# openssl rand -base64 32
KEYSTATIC_SECRET=
