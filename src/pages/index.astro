---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
---

<Layout title="inicio" ruta="inicio" cmd="sinack --help" sub="labs, redes y seguridad">
  <div class="bloque">
    <h3>secciones</h3>
    <div class="help">
      <a class="row" href="/blog"><span class="flag">--blog</span><span>posts, opinión y actualidad comentada</span></a>
      <a class="row" href="/labs"><span class="flag">--labs</span><span>laboratorios montados paso a paso, con su repo</span></a>
      <a class="row" href="/docs"><span class="flag">--docs</span><span>fichas de configuración y apuntes de referencia</span></a>
      <a class="row" href="/portfolio"><span class="flag">--portfolio</span><span>proyectos y herramientas propias</span></a>
      <a class="row" href="/sobre"><span class="flag">--sobre</span><span>qué es esto y por qué existe</span></a>
    </div>
  </div>

  <div class="bloque">
    <h3>buscar</h3>
    <div class="cli">
      <div class="cli-prompt">
        <span class="sign">$</span> buscar
        <input
          id="homeSearchInput"
          type="text"
          autocomplete="off"
          spellcheck="false"
          placeholder="título de un post, lab o ficha…"
        />
      </div>
    </div>
    <div class="cli-hint" id="homeSearchHint"></div>
  </div>
</Layout>
