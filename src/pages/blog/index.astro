---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts", ({ data }) => !data.draft && data.tipo === "blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = (d: Date) => d.toISOString().slice(0, 10);
---

<Layout title="blog" ruta="blog" cmd="sinack --blog" sub="posts, opinión y actualidad comentada">
  <ul class="posts">
    {posts.map((post) => (
      <li class="post">
        <div class="meta">
          <span>{fmt(post.data.pubDate)}</span>
          <span>[{post.data.author.toUpperCase()}]</span>
        </div>
        <h2><a href={`/blog/${post.id}`}>{post.data.title}</a></h2>
        <p>{post.data.description}</p>
        <div class="tags">
          {post.data.tags.map((t) => <span>#{t}</span>)}
        </div>
      </li>
    ))}
  </ul>
</Layout>
