---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { getCollection } from "astro:content";

interface Props {
  title: string;
  ruta: string;
  cmd: string;
  sub?: string;
}

const { title, ruta, cmd, sub = "" } = Astro.props;

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const numPosts = allPosts.filter((p) => p.data.tipo === "blog").length;
const numLabs = allPosts.filter((p) => p.data.tipo === "lab").length;

const nav = [
  { href: "/", key: "home", label: "inicio" },
  { href: "/blog", key: "blog", label: "blog" },
  { href: "/labs", key: "labs", label: "labs" },
  { href: "/docs", key: "docs", label: "documentación" },
  { href: "/portfolio", key: "folio", label: "portfolio" },
  { href: "/sobre", key: "sobre", label: "sobre" },
];

const path = Astro.url.pathname;
function isOn(href: string) {
  if (href === "/") return path === "/";
  return path.startsWith(href);
}
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — sinack</title>
  <meta name="description" content="sinack — labs, redes y seguridad" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap"
    rel="stylesheet"
  />
  <ClientRouter />
  <script is:inline>
    (function () {
      if (localStorage.getItem("sinack:sidebar") === "collapsed") {
        document.documentElement.classList.add("sidebar-collapsed");
      }
    })();
  </script>
</head>
<body>
  <div class="topbar">
    <div class="path">
      <button type="button" class="side-toggle" id="sideToggle" title="mostrar / ocultar menú" aria-label="mostrar u ocultar menú">☰</button>
      sinack@web:~/<b>{ruta}</b>
    </div>
    <div class="right">
      <button type="button" class="search-btn" id="searchBtn" data-open-search>
        buscar <kbd>/</kbd>
      </button>
      <span class="dot dot-ok" title="sitio activo"></span>
      <div class="menu">
        <button type="button" class="menu-btn" id="menuBtn" aria-haspopup="true" aria-expanded="false">
          menú <span class="menu-caret">▾</span>
        </button>
        <div class="menu-drop" id="menuDrop" hidden>
          <a href="#">ajustes</a>
          <a href="https://github.com/sinackblog/web/issues/new" target="_blank" rel="noreferrer">contacto</a>
          <a href="/sobre">ayuda</a>
        </div>
      </div>
    </div>
  </div>

  <div class="frame">
    <aside>
      <div class="mark-row">
        <a class="mark" href="/">sinack&gt;_</a>
      </div>
      <nav class="tree">
        <div class="root">~/</div>
        {nav.map((n) => (
          <a href={n.href} class={isOn(n.href) ? "on" : ""}>{n.label}</a>
        ))}
      </nav>
      <div class="side-meta">
        <b>posts</b> {numPosts} · <b>labs</b> {numLabs}
      </div>
    </aside>

    <main>
      <div class="head">
        <div class="line">
          <span class="sign">$</span> <span id="cmd" data-cmd={cmd}></span><span class="cursor blink" id="cur"></span>
        </div>
        <span class="sub" id="sub" data-sub={sub}></span>
      </div>

      <div class="stage" id="stage">
        <slot />
      </div>
    </main>
  </div>

  <div class="search-overlay" id="searchOverlay" hidden>
    <div class="search-box">
      <div class="search-banner">sinack — buscador<br />escribe un título y pulsa Intro</div>
      <div class="search-prompt">
        <span class="sign">$</span> buscar
        <input
          id="searchInput"
          type="text"
          autocomplete="off"
          spellcheck="false"
          placeholder="título de un post, lab o ficha…"
        />
      </div>
      <div class="search-results" id="searchResults"></div>
    </div>
  </div>

  <div class="pie">
    <div class="cols">
      <div class="pie-brand">
        <span class="pie-icon">&gt;ack</span>
        <p>Labs, redes y seguridad. Todo escrito fuera de horario, sin encargo de nadie.</p>
      </div>
      <div>
        <h5>secciones</h5>
        <a href="/blog">blog</a>
        <a href="/labs">labs</a>
        <a href="/docs">documentación</a>
        <a href="/portfolio">portfolio</a>
      </div>
      <div>
        <h5>el sitio</h5>
        <a href="/sobre">sobre sinack</a>
        <a href="#" data-open-search>buscar</a>
      </div>
    </div>
    <div class="legal">
      <span>sinack.es</span>
      <span>© {new Date().getFullYear()} sinack. Todo el contenido pertenece a sinack.</span>
    </div>
  </div>

  <script>
    function typeHeader() {
      const cmdEl = document.getElementById("cmd");
      const subEl = document.getElementById("sub");
      const stage = document.getElementById("stage");
      if (!cmdEl || !subEl || !stage) return;

      const cmd = cmdEl.getAttribute("data-cmd") || "";
      const sub = subEl.getAttribute("data-sub") || "";
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const primera = !sessionStorage.getItem("sinack:visitado");
      sessionStorage.setItem("sinack:visitado", "1");

      const runId = ((window as any).__sinackRunId = ((window as any).__sinackRunId || 0) + 1);
      const isCurrent = () => (window as any).__sinackRunId === runId;

      stage.classList.remove("in");
      subEl.textContent = "";
      cmdEl.textContent = "";

      if (reduce) {
        cmdEl.textContent = cmd;
        subEl.textContent = sub;
        stage.classList.add("in");
        return;
      }

      const vel = primera ? 56 : 22;
      let i = 0;
      function paso() {
        if (!isCurrent()) return;
        if (i <= cmd.length) {
          cmdEl.textContent = cmd.slice(0, i++);
          setTimeout(paso, vel);
        } else {
          setTimeout(() => {
            if (!isCurrent()) return;
            subEl.textContent = sub;
            stage.classList.add("in");
          }, primera ? 260 : 140);
        }
      }
      paso();
    }

    function runToggle(e: Event) {
      const target = e.target as HTMLElement;
      const btn = target.closest(".run button");
      if (!btn) return;
      const box = btn.parentElement as HTMLElement;
      const out = box.querySelector(".out") as HTMLElement | null;
      if (!out) return;
      if (box.classList.contains("open")) {
        box.classList.remove("open");
        out.textContent = "";
        return;
      }
      box.classList.add("open");
      const txt = out.getAttribute("data-out") || "";
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduce) {
        out.textContent = txt;
        return;
      }
      let j = 0;
      function esc() {
        if (j <= txt.length) {
          out!.textContent = txt.slice(0, j);
          j += 3;
          setTimeout(esc, 8);
        } else {
          out!.textContent = txt;
        }
      }
      esc();
    }

    function closeMenu() {
      const btn = document.getElementById("menuBtn");
      const drop = document.getElementById("menuDrop");
      if (!btn || !drop) return;
      drop.hidden = true;
      btn.setAttribute("aria-expanded", "false");
    }

    function menuToggle(e: Event) {
      const target = e.target as HTMLElement;
      const btn = document.getElementById("menuBtn");
      const drop = document.getElementById("menuDrop");
      if (!btn || !drop) return;
      if (target.closest("#menuBtn")) {
        const open = drop.hidden;
        drop.hidden = !open;
        btn.setAttribute("aria-expanded", String(open));
        return;
      }
      if (!target.closest("#menuDrop")) closeMenu();
    }

    function toggleSidebar() {
      const collapsed = document.documentElement.classList.toggle("sidebar-collapsed");
      localStorage.setItem("sinack:sidebar", collapsed ? "collapsed" : "expanded");
    }

    type SearchItem = { title: string; url: string; section: string };
    type Widget = { input: HTMLInputElement; results: HTMLElement; items: SearchItem[]; selected: number };

    let searchIndex: SearchItem[] | null = null;
    const widgets = new Map<HTMLInputElement, Widget>();

    async function loadSearchIndex(): Promise<SearchItem[]> {
      if (searchIndex) return searchIndex;
      const res = await fetch("/buscar-index.json");
      searchIndex = await res.json();
      return searchIndex!;
    }

    function filterItems(items: SearchItem[], q: string) {
      const query = q.trim().toLowerCase();
      const matches = query ? items.filter((it) => it.title.toLowerCase().includes(query)) : items;
      return matches.slice(0, 8);
    }

    function renderWidget(w: Widget) {
      w.results.innerHTML = "";
      w.items.forEach((item, i) => {
        const row = document.createElement("div");
        row.className = "s-row" + (i === w.selected ? " on" : "");
        row.dataset.index = String(i);
        const title = document.createElement("span");
        title.className = "s-title";
        title.textContent = item.title;
        const section = document.createElement("span");
        section.className = "s-section";
        section.textContent = item.section;
        row.append(title, section);
        w.results.appendChild(row);
      });
    }

    function setSelected(w: Widget, i: number) {
      w.selected = i;
      [...w.results.children].forEach((el, idx) => el.classList.toggle("on", idx === i));
    }

    function moveSelection(w: Widget, delta: number) {
      if (!w.items.length) return;
      setSelected(w, Math.max(0, Math.min(w.items.length - 1, w.selected + delta)));
    }

    function activateSelection(w: Widget) {
      const item = w.items[w.selected];
      if (item) window.location.href = item.url;
    }

    async function updateWidget(w: Widget) {
      const all = await loadSearchIndex();
      w.items = filterItems(all, w.input.value);
      w.selected = w.items.length ? 0 : -1;
      renderWidget(w);
    }

    function setupWidget(input: HTMLInputElement | null, results: HTMLElement | null) {
      if (!input || !results) return;
      const w: Widget = { input, results, items: [], selected: -1 };
      widgets.set(input, w);
      updateWidget(w);
    }

    function initSearchWidgets() {
      widgets.clear();
      setupWidget(
        document.getElementById("searchInput") as HTMLInputElement | null,
        document.getElementById("searchResults")
      );
      setupWidget(
        document.getElementById("homeSearchInput") as HTMLInputElement | null,
        document.getElementById("homeSearchResults")
      );
    }

    function openSearch() {
      const overlay = document.getElementById("searchOverlay") as HTMLElement | null;
      const input = document.getElementById("searchInput") as HTMLInputElement | null;
      if (!overlay || !input) return;
      overlay.hidden = false;
      input.value = "";
      requestAnimationFrame(() => overlay.classList.add("in"));
      input.focus();
      const w = widgets.get(input);
      if (w) updateWidget(w);
    }

    function closeSearch() {
      const overlay = document.getElementById("searchOverlay") as HTMLElement | null;
      if (!overlay) return;
      overlay.classList.remove("in");
      overlay.hidden = true;
    }

    function onGlobalKeydown(e: KeyboardEvent) {
      const overlay = document.getElementById("searchOverlay") as HTMLElement | null;
      const active = document.activeElement as HTMLElement | null;
      const w = active ? widgets.get(active as HTMLInputElement) : undefined;

      if (overlay && !overlay.hidden && e.key === "Escape") {
        e.preventDefault();
        closeSearch();
        return;
      }

      if (w) {
        if (e.key === "ArrowDown") {
          e.preventDefault();
          moveSelection(w, 1);
          return;
        }
        if (e.key === "ArrowUp") {
          e.preventDefault();
          moveSelection(w, -1);
          return;
        }
        if (e.key === "Enter") {
          e.preventDefault();
          activateSelection(w);
          return;
        }
      }

      const typing = active && (active.tagName === "INPUT" || active.tagName === "TEXTAREA");
      if (e.key === "/" && !typing && (!overlay || overlay.hidden)) {
        e.preventDefault();
        openSearch();
      }
    }

    function onDocClick(e: Event) {
      const target = e.target as HTMLElement;
      if (target.closest("[data-open-search]")) {
        openSearch();
        return;
      }
      if (target.closest("#sideToggle")) {
        toggleSidebar();
        return;
      }
      const row = target.closest(".s-row") as HTMLElement | null;
      if (row) {
        const container = row.parentElement as HTMLElement;
        for (const w of widgets.values()) {
          if (w.results === container) {
            const item = w.items[Number(row.dataset.index)];
            if (item) window.location.href = item.url;
            break;
          }
        }
        return;
      }
      const overlay = document.getElementById("searchOverlay");
      if (overlay && !overlay.hidden && target === overlay) closeSearch();
    }

    if (!(window as any).__sinackBound) {
      (window as any).__sinackBound = true;
      document.addEventListener("astro:page-load", typeHeader);
      document.addEventListener("astro:page-load", closeMenu);
      document.addEventListener("astro:page-load", closeSearch);
      document.addEventListener("astro:page-load", initSearchWidgets);
      document.addEventListener("click", runToggle);
      document.addEventListener("click", menuToggle);
      document.addEventListener("click", onDocClick);
      document.addEventListener("keydown", onGlobalKeydown);
      document.addEventListener("input", (e) => {
        const w = widgets.get(e.target as HTMLInputElement);
        if (w) updateWidget(w);
      });
    }
  </script>
</body>
</html>
